{
  "schemaVersion": 1,
  "product": "LUKE AI STUDIO",
  "catalogVersion": "1.0.0-beta.7",
  "defaultDownloadDirectory": "/Volumes/EXTERNAL Drive/ai/ai-downloads",
  "fallbackDownloadDirectory": "~/Downloads/LUKE-AI-STUDIO",
  "dependencies": [
    {
      "id": "portable-node",
      "name": {
        "en": "Portable Node.js",
        "th": "Node.js แบบพกพา"
      },
      "category": "core-runtime",
      "required": true,
      "platforms": ["darwin-arm64"],
      "checks": [
        {
          "type": "executable",
          "path": "app/tools/node-mac/bin/node",
          "versionArgument": "--version"
        }
      ],
      "install": {
        "mode": "release-package",
        "requiresChecksum": true,
        "supportsRollback": true
      }
    },
    {

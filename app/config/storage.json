    "archivedReleases": "releases/archive",
    "updates": "updates",
    "models": "models",
    "llmModels": "models/llm",
    "visionModels": "models/vision",
    "videoModels": "models/video",
    "speechModels": "models/speech",
    "embeddingModels": "models/embedding",
    "assets": "assets",
    "plugins": "plugins",
    "backups": "backups",
    "logs": "logs",
    "temp": "temp"
  }
}

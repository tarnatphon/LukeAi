{
  "version": 1,
  "product": "LUKE AI STUDIO",
  "storageMode": "external",
  "externalVolume": "/Volumes/AI",
  "downloadRoot": "/Volumes/AI/ai-downloads",
  "fallbackRoot": "~/Library/Application Support/LUKE AI STUDIO/ai-downloads",

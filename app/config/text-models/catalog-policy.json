      "name": {
        "en": "Community Models",
        "th": "โมเดลชุมชน"
      }
    },
    {
      "id": "coding",
      "name": {
        "en": "Coding Models",
        "th": "โมเดลเขียนโปรแกรม"
      }
    },
    {
      "id": "reasoning",
      "name": {
        "en": "Reasoning Models",
        "th": "โมเดลการให้เหตุผล"
      }
    }
  ],
  "safetyProfiles": [
    {
      "id": "standard",
      "name": {
        "en": "Standard",
        "th": "มาตรฐาน"
      }
    },
    {
      "id": "balanced",
      "name": {
        "en": "Balanced",
        "th": "สมดุล"
      }
    },
    {
      "id": "community",
      "name": {
        "en": "Community",
        "th": "ชุมชน"
      },
      "description": {
        "en": "Model behavior and response policies are defined by the model publisher.",
        "th": "รูปแบบการตอบและนโยบายของโมเดลขึ้นอยู่กับผู้พัฒนาโมเดล"
      }
    }
  ],
  "communityModelPolicy": {
    "enabled": true,
    "sameDownloadQueueAsOfficialModels": true,
    "oneClickDownloadRequired": true,
    "openExternalWebsiteForDownload": false,
    "automaticUpdateCheck": true,
    "showUpdateInsideModelCard": true,
    "verifyPublisher": true,
    "verifySha256": true,
    "installSideBySide": true,
    "keepPreviousVersionForRollback": true,
    "confirmBeforeDeletingPreviousVersion": true,
    "showLicenseBeforeFirstInstall": true,
    "showSafetyProfile": true
  }
}
